{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:zeus17:itsm:engine-inputs:v1",
 "title": "ITSM engine inputs (strictly typed; no unresolved state)",
 "x-enums-source": "../itsm-workflow-tool-v25.html (regenerated by build_schemas.py; verified by check_schemas.py)",
 "$defs": {
  "incident_score": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "users",
    "business",
    "workaround",
    "duration",
    "regulatory",
    "recurring"
   ],
   "properties": {
    "users": {
     "enum": [
      1,
      2,
      3,
      4,
      5
     ],
     "description": "Affected users band 1-5. The form's 0 ('Unknown / not assessed') is deliberately NOT valid here: it scores 0 and silently lowers the suggested tier."
    },
    "business": {
     "enum": [
      0,
      1,
      2,
      3,
      4,
      5
     ]
    },
    "workaround": {
     "enum": [
      0,
      1,
      2
     ]
    },
    "duration": {
     "enum": [
      0,
      1,
      2,
      3,
      4
     ],
     "description": "Option 4 ('Recurring / seen before') overlaps the separate 'recurring' factor; both are counted by the engine."
    },
    "regulatory": {
     "enum": [
      0,
      2,
      4,
      5
     ]
    },
    "recurring": {
     "enum": [
      0,
      2,
      4
     ]
    }
   }
  },
  "severity_record": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "severity"
   ],
   "properties": {
    "severity": {
     "enum": [
      "P1",
      "P2",
      "P3",
      "P4"
     ]
    }
   }
  },
  "intel_hint": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "incidentType"
   ],
   "properties": {
    "incidentType": {
     "enum": [
      "",
      "application",
      "infrastructure",
      "thirdparty",
      "security",
      "data",
      "network",
      "process",
      "other"
     ]
    }
   }
  },
  "preflight": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "shortDescription",
    "observation",
    "service",
    "startedAt",
    "diagnosis",
    "assignmentGroup",
    "ci",
    "resolvedAt",
    "resolution",
    "rootCause",
    "permanentFix",
    "severity",
    "triageScore",
    "timelineCount",
    "decisionCount",
    "regulatoryFlagChecked"
   ],
   "properties": {
    "shortDescription": {
     "type": "string"
    },
    "observation": {
     "type": "string"
    },
    "service": {
     "type": "string"
    },
    "startedAt": {
     "type": "string"
    },
    "diagnosis": {
     "type": "string"
    },
    "assignmentGroup": {
     "type": "string"
    },
    "ci": {
     "type": "string"
    },
    "resolvedAt": {
     "type": "string"
    },
    "resolution": {
     "type": "string"
    },
    "rootCause": {
     "type": "string"
    },
    "permanentFix": {
     "type": "string"
    },
    "severity": {
     "enum": [
      "",
      "P1",
      "P2",
      "P3",
      "P4"
     ]
    },
    "triageScore": {
     "type": "integer",
     "minimum": 0,
     "maximum": 25
    },
    "timelineCount": {
     "type": "integer",
     "minimum": 0
    },
    "decisionCount": {
     "type": "integer",
     "minimum": 0
    },
    "regulatoryFlagChecked": {
     "type": "boolean"
    }
   }
  },
  "change_risk": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "blast",
    "complexity",
    "rollback",
    "testing",
    "history",
    "timing"
   ],
   "properties": {
    "blast": {
     "enum": [
      5,
      10,
      20,
      30
     ]
    },
    "complexity": {
     "enum": [
      5,
      10,
      20,
      25
     ]
    },
    "rollback": {
     "enum": [
      2,
      8,
      15,
      20
     ]
    },
    "testing": {
     "enum": [
      2,
      8,
      15,
      20
     ]
    },
    "history": {
     "enum": [
      2,
      5,
      10,
      15
     ]
    },
    "timing": {
     "enum": [
      2,
      5,
      8,
      10
     ]
    }
   }
  },
  "routing_suggestion": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "observation",
    "service"
   ],
   "properties": {
    "observation": {
     "type": "string"
    },
    "service": {
     "type": "string"
    }
   }
  },
  "currency_risk": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "certificates",
    "vulnerabilities",
    "supportStatus",
    "lastPentest",
    "lastPatched"
   ],
   "properties": {
    "certificates": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "name",
       "status",
       "daysLeft"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "status": {
        "enum": [
         "unknown",
         "expired",
         "critical",
         "warn",
         "ok"
        ]
       },
       "daysLeft": {
        "type": "integer"
       }
      }
     }
    },
    "vulnerabilities": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "severity"
      ],
      "properties": {
       "severity": {
        "enum": [
         "critical",
         "high",
         "medium",
         "advisory"
        ]
       }
      }
     }
    },
    "supportStatus": {
     "enum": [
      "",
      "active",
      "lts",
      "maintenance",
      "eol_soon",
      "eol",
      "unknown"
     ],
     "description": "'' = Not checked. Since Q-11 (2026-10-10) 'unknown' raises a prompt to confirm the support status."
    },
    "lastPentest": {
     "type": "string",
     "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
    },
    "lastPatched": {
     "type": "string",
     "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
    }
   }
  },
  "sla_clock": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "severity",
    "startedAt",
    "pausedMinutes"
   ],
   "properties": {
    "severity": {
     "enum": [
      "P1",
      "P2",
      "P3",
      "P4"
     ]
    },
    "startedAt": {
     "type": "string",
     "minLength": 1,
     "description": "Incident start time (local date-time)."
    },
    "pausedMinutes": {
     "type": "integer",
     "minimum": 0
    }
   }
  }
 }
}
